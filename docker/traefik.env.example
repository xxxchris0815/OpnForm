# Copy to docker/traefik.env (gitignored) and set OPNFORM_DOMAIN.
# Used by: ./scripts/docker-compose-traefik.sh config|up -d

OPNFORM_DOMAIN=forms.example.com

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Must match an existing Docker network that the Traefik container is already on.
# List names with: docker network ls
TRAEFIK_DOCKER_NETWORK=traefik

# Keep host port 80 free for Traefik. Ingress stays on the Docker network at :80.
OPNFORM_INGRESS_IP=127.0.0.1
OPNFORM_INGRESS_PORT=18080
