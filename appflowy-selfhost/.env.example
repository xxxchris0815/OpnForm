# =============================================================================
# AppFlowy Cloud – Production .env (Stand Images: 2026-09-09)
# Kopieren nach .env und Werte ändern, bevor du `docker compose up -d` startest.
# =============================================================================

# Öffentliche URL hinter Caddy (HTTPS)
FQDN=appflowy.example.com
SCHEME=https
WS_SCHEME=wss

APPFLOWY_BASE_URL=${SCHEME}://${FQDN}
APPFLOWY_WEBSOCKET_BASE_URL=${WS_SCHEME}://${FQDN}/ws/v2
APPFLOWY_WEB_URL=${APPFLOWY_BASE_URL}

# Port, den Caddy anspricht (Host-Bindung)
APPFLOWY_BIND_ADDRESS=127.0.0.1
APPFLOWY_HTTP_PORT=8080

# Name des Docker-Netzes deines Caddy-Stacks (nur mit docker-compose.proxy.yml)
PROXY_NETWORK=caddy

# =============================================================================
# Image-Versionen (aktuellste Tags auf Docker Hub, 2026-09-09)
# =============================================================================
APPFLOWY_CLOUD_VERSION=0.18.6
GOTRUE_VERSION=0.18.6
APPFLOWY_WORKER_VERSION=0.18.6
APPFLOWY_WEB_VERSION=0.18.2
APPFLOWY_SEARCH_VERSION=0.18.4
APPFLOWY_ADMIN_FRONTEND_VERSION=0.17.13
APPFLOWY_AI_VERSION=0.17.7

# =============================================================================
# Secrets – vor dem Start ersetzen (openssl rand -base64 32)
# =============================================================================
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
GOTRUE_JWT_SECRET=CHANGE_ME_JWT_SECRET
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AWS_ACCESS_KEY=CHANGE_ME_MINIO_USER
AWS_SECRET=CHANGE_ME_MINIO_PASSWORD

# =============================================================================
# Datenbank & Cache
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres

REDIS_HOST=redis
REDIS_PORT=6379

APPFLOWY_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
GOTRUE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?search_path=auth
APPFLOWY_REDIS_URI=redis://${REDIS_HOST}:${REDIS_PORT}
APPFLOWY_GOTRUE_BASE_URL=http://gotrue:9999
API_EXTERNAL_URL=${APPFLOWY_BASE_URL}/gotrue

APPFLOWY_ACCESS_CONTROL=true
APPFLOWY_DATABASE_MAX_CONNECTIONS=40

# =============================================================================
# Auth
# =============================================================================
GOTRUE_JWT_EXP=604800
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=100
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=
SIGNUP_WHITELIST_ENABLED=false
GUEST_INVITES_REQUIRE_ADMIN_APPROVAL=false

# =============================================================================
# SMTP (optional, für Bestätigungsmails)
# Bei Nutzung: GOTRUE_MAILER_AUTOCONFIRM=false setzen
# =============================================================================
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=

APPFLOWY_MAILER_SMTP_HOST=
APPFLOWY_MAILER_SMTP_PORT=465
APPFLOWY_MAILER_SMTP_USERNAME=
APPFLOWY_MAILER_SMTP_EMAIL=
APPFLOWY_MAILER_SMTP_PASSWORD=
APPFLOWY_MAILER_SMTP_TLS_KIND=wrapper

# =============================================================================
# OAuth (optional)
# =============================================================================
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=
GOTRUE_EXTERNAL_DISCORD_SECRET=
GOTRUE_EXTERNAL_DISCORD_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_SAML_ENABLED=false
GOTRUE_SAML_PRIVATE_KEY=

# =============================================================================
# MinIO / S3
# =============================================================================
MINIO_HOST=minio
MINIO_PORT=9000
APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_MINIO_URL=http://${MINIO_HOST}:${MINIO_PORT}
APPFLOWY_S3_ACCESS_KEY=${AWS_ACCESS_KEY}
APPFLOWY_S3_SECRET_KEY=${AWS_SECRET}
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1
APPFLOWY_S3_PRESIGNED_URL_ENDPOINT=${APPFLOWY_BASE_URL}/minio-api

# =============================================================================
# AI (optional – ohne Key laufen die Dienste, Features bleiben inaktiv)
# =============================================================================
AI_ENABLED=true
AI_OPENAI_API_KEY=
AI_SERVER_PORT=5001
AI_SERVER_HOST=ai
DEFAULT_AI_MODEL=gpt-4.1-mini
DEFAULT_AI_COMPLETION_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_BASE=https://api.assemblyai.com/v2
ASSEMBLYAI_STREAMING_API_BASE=https://streaming.assemblyai.com/v3

# =============================================================================
# Worker / Search
# =============================================================================
APPFLOWY_WORKER_REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
APPFLOWY_WORKER_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APPFLOWY_WORKER_DATABASE_NAME=${POSTGRES_DB}
APPFLOWY_INDEXER_DATABASE_ENABLED=false
APPFLOWY_KEYWORD_SEARCH_ENABLED=true

RUST_LOG=info
